# Leave empty in development (Vite proxies to localhost:4000).
# In production set to your Render API URL, e.g. https://nearby-api.onrender.com
VITE_API_URL=
VITE_APP_NAME=Nearby
# Same Web client ID as GOOGLE_CLIENT_ID on the server. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
# "Buy me a coffee": your UPI ID. The QR is generated from it and the payer chooses the amount.
VITE_UPI_ID=
VITE_UPI_NAME=
# Optional: use your own QR image instead (put the file in client/public, e.g. /my-qr.png)
VITE_QR_IMAGE=
